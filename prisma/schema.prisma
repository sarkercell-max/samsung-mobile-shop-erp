// ============================================================================
// Samsung Mobile Shop ERP — Prisma Schema
// PostgreSQL (Supabase). Multi-store ready via `storeId` on every tenant table.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum UserRole {
  OWNER
  MANAGER
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  SOLD
  RETURNED
  LOST
  CANCELLED // unit's purchase batch was voided before it was ever sold
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  ROCKET
  CARD
  BANK
  SPLIT
}

enum PromoType {
  CASHBACK
  GIFT
  DEALER_INCENTIVE
}

enum ExpenseCategory {
  RENT
  SALARY
  ELECTRICITY
  INTERNET
  MARKETING
  TRANSPORT
  MISCELLANEOUS
}

enum SaleStatus {
  COMPLETED
  RETURNED
  CANCELLED
}

enum PurchaseStatus {
  RECEIVED
  CANCELLED
}

// ----------------------------------------------------------------------------
// CORE / TENANCY
// ----------------------------------------------------------------------------

/// A physical Samsung retail shop. Everything below is scoped to a Store,
/// which is what makes the system scale to multiple locations.
model Store {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  products        Product[]
  purchaseBatches PurchaseBatch[]
  inventory       Inventory[]
  customers       Customer[]
  sales           Sale[]
  expenses        Expense[]
  promotions      Promotion[]
  auditLogs       AuditLog[]
  settings        Settings?
  priceHistory    ProductPriceHistory[]
  suppliers       Supplier[]
  supplierPayments SupplierPayment[]

  @@map("stores")
}

/// Mirrors Supabase auth.users via `authId`. Business profile + role lives here.
model User {
  id        String   @id @default(uuid())
  authId    String   @unique // Supabase auth.users.id
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  email     String   @unique
  phone     String?
  role      UserRole
  isActive  Boolean  @default(true)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // soft delete

  purchaseBatches         PurchaseBatch[]        @relation("CreatedByUser")
  supplierPayments        SupplierPayment[]      @relation("SupplierPaymentCreatedBy")
  cancelledPurchaseBatches PurchaseBatch[]       @relation("CancelledByUser")
  sales                   Sale[]                 @relation("SoldByUser")
  expenses                Expense[]              @relation("RecordedByUser")
  auditLogs               AuditLog[]
  priceHistoryEntries     ProductPriceHistory[]  @relation("PriceSetByUser")

  @@index([storeId])
  @@map("users")
}

// ----------------------------------------------------------------------------
// PRODUCT
// ----------------------------------------------------------------------------

model Product {
  id                 String   @id @default(uuid())
  storeId            String
  store              Store    @relation(fields: [storeId], references: [id])
  brand              String   @default("Samsung")
  model              String // e.g. "Galaxy S24 Ultra"
  ram                String // e.g. "12GB"
  storageCapacity    String // e.g. "256GB"  (renamed from `storage` — reserved word risk)
  color              String
  sku                String   @unique
  barcode            String?  @unique
  defaultSellingPrice Decimal @db.Decimal(12, 2) // denormalized cache of the CURRENT active ProductPriceHistory.salePrice — never the source of truth
  defaultBuyingPrice  Decimal? @db.Decimal(12, 2) // denormalized cache of the CURRENT active ProductPriceHistory.purchasePrice — prefill only
  imageUrl           String?
  isActive            Boolean @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  purchaseItems PurchaseItem[]
  inventory     Inventory[]
  promotions    Promotion[]
  saleItems     SaleItem[]
  priceHistory  ProductPriceHistory[]

  @@unique([storeId, model, ram, storageCapacity, color])
  @@index([storeId])
  @@index([model])
  @@map("products")
}

// ----------------------------------------------------------------------------
// PRODUCT PRICE HISTORY
// Purchase price and sale price are NOT fixed — a store can revise them
// mid-month. This table is the source of truth for "what was the current
// list price on date X"; it never overwrites past periods. Product.default*
// columns are a denormalized cache of whichever row here is currently open
// (effectiveTo IS NULL), kept in sync by the pricing server action.
//
// Historical Inventory/SaleItem rows store their OWN captured price at the
// time of purchase/sale — those snapshots are what make old invoices and
// old inventory valuation immune to later price changes.
// ----------------------------------------------------------------------------

model ProductPriceHistory {
  id             String    @id @default(uuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id])
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  purchasePrice  Decimal   @db.Decimal(12, 2)
  salePrice      Decimal   @db.Decimal(12, 2)
  effectiveFrom  DateTime
  effectiveTo    DateTime? // null = currently open/active period
  createdById    String
  createdBy      User      @relation("PriceSetByUser", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([storeId, productId])
  @@index([productId, effectiveFrom, effectiveTo])
  @@map("product_price_history")
}

// ----------------------------------------------------------------------------
// PURCHASE
// ----------------------------------------------------------------------------

model PurchaseBatch {
  id             String   @id @default(uuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id])
  purchaseNumber String   @unique // auto-generated e.g. PB-2026-0001
  supplierName   String
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id])
  batchNumber    String
  purchaseDate   DateTime
  remarks        String?
  status         PurchaseStatus @default(RECEIVED)
  createdById    String
  createdBy      User     @relation("CreatedByUser", fields: [createdById], references: [id])
  cancelledAt    DateTime?
  cancelledById  String?
  cancelledBy    User?    @relation("CancelledByUser", fields: [cancelledById], references: [id])
  cancelReason   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items PurchaseItem[]

  @@index([storeId])
  @@index([status])
  @@map("purchase_batches")
}

model Supplier {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchases PurchaseBatch[]
  payments  SupplierPayment[]

  @@unique([storeId, name])
  @@index([storeId])
  @@map("suppliers")
}

model SupplierPayment {
  id            String        @id @default(uuid())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id])
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  paymentDate   DateTime
  paymentMethod PaymentMethod
  reference     String?
  note          String?
  createdById   String
  createdBy     User          @relation("SupplierPaymentCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([storeId, paymentDate])
  @@index([supplierId, paymentDate])
  @@map("supplier_payments")
}

model PurchaseItem {
  id              String        @id @default(uuid())
  purchaseBatchId String
  purchaseBatch   PurchaseBatch @relation(fields: [purchaseBatchId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  imei            String        @unique
  buyingPrice     Decimal       @db.Decimal(12, 2)
  quantity        Int           @default(1) // always 1 per IMEI row; kept for audit clarity
  createdAt       DateTime      @default(now())

  inventory Inventory?

  @@index([purchaseBatchId])
  @@index([productId])
  @@map("purchase_items")
}

// ----------------------------------------------------------------------------
// INVENTORY — the IMEI-level single source of truth
// ----------------------------------------------------------------------------

model Inventory {
  id              String           @id @default(uuid())
  storeId         String
  store           Store            @relation(fields: [storeId], references: [id])
  productId       String
  product         Product          @relation(fields: [productId], references: [id])
  purchaseItemId  String           @unique
  purchaseItem    PurchaseItem     @relation(fields: [purchaseItemId], references: [id])
  imei            String           @unique
  buyingPrice     Decimal          @db.Decimal(12, 2)
  sellingPrice    Decimal          @db.Decimal(12, 2) // current price, may diverge from product default
  status          InventoryStatus  @default(AVAILABLE)
  warrantyMonths  Int              @default(12)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  saleItem SaleItem?

  @@index([storeId, status])
  @@index([imei])
  @@map("inventory")
}

// ----------------------------------------------------------------------------
// CUSTOMER
// ----------------------------------------------------------------------------

model Customer {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  phone     String
  name      String
  address   String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // soft delete/archive — only allowed when the customer has zero sales

  sales Sale[]

  @@unique([storeId, phone])
  @@index([phone])
  @@map("customers")
}

// ----------------------------------------------------------------------------
// SALES
// ----------------------------------------------------------------------------

model Sale {
  id            String        @id @default(uuid())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id])
  invoiceNumber String        @unique // e.g. INV-2026-000123
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  soldById      String
  soldBy        User          @relation("SoldByUser", fields: [soldById], references: [id])
  status        SaleStatus    @default(COMPLETED)
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @db.Decimal(12, 2) @default(0)
  promoAmount   Decimal       @db.Decimal(12, 2) @default(0)
  total         Decimal       @db.Decimal(12, 2)
  totalProfit   Decimal       @db.Decimal(12, 2)
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime? // soft delete — owner only

  items    SaleItem[]
  payments Payment[]

  @@index([storeId])
  @@index([customerId])
  @@index([soldById])
  @@map("sales")
}

model SaleItem {
  id            String    @id @default(uuid())
  saleId        String
  sale          Sale      @relation(fields: [saleId], references: [id])
  inventoryId   String    @unique // one IMEI can only ever be sold once
  inventory     Inventory @relation(fields: [inventoryId], references: [id])
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  buyingPrice   Decimal   @db.Decimal(12, 2) // snapshot at sale time
  sellingPrice  Decimal   @db.Decimal(12, 2) // snapshot at sale time
  discount      Decimal   @db.Decimal(12, 2) @default(0)
  promoAmount   Decimal   @db.Decimal(12, 2) @default(0)
  profit        Decimal   @db.Decimal(12, 2) // sellingPrice - buyingPrice + promoAmount - discount
  promotionId   String?
  promotion     Promotion? @relation(fields: [promotionId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

model Payment {
  id       String        @id @default(uuid())
  saleId   String
  sale     Sale          @relation(fields: [saleId], references: [id])
  method   PaymentMethod
  amount   Decimal       @db.Decimal(12, 2)
  reference String? // txn id for bkash/nagad/card etc.
  createdAt DateTime     @default(now())

  @@index([saleId])
  @@map("payments")
}

// ----------------------------------------------------------------------------
// PROMOTIONS
// ----------------------------------------------------------------------------

model Promotion {
  id          String    @id @default(uuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  month       String // "2026-08"
  startDate   DateTime
  endDate     DateTime
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  promoAmount Decimal   @db.Decimal(12, 2)
  promoType   PromoType
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  saleItems SaleItem[]

  @@index([storeId, productId])
  @@index([startDate, endDate])
  @@map("promotions")
}

// ----------------------------------------------------------------------------
// EXPENSES
// ----------------------------------------------------------------------------

model Expense {
  id           String          @id @default(uuid())
  storeId      String
  store        Store           @relation(fields: [storeId], references: [id])
  category     ExpenseCategory
  amount       Decimal         @db.Decimal(12, 2)
  description  String?
  expenseDate  DateTime
  recordedById String
  recordedBy   User            @relation("RecordedByUser", fields: [recordedById], references: [id])
  createdAt    DateTime        @default(now())

  @@index([storeId, expenseDate])
  @@map("expenses")
}

// ----------------------------------------------------------------------------
// AUDIT / SETTINGS
// ----------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String // e.g. "sale.create", "product.price_update", "sale.delete"
  entityType String // e.g. "Sale"
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([storeId, entityType])
  @@map("audit_logs")
}

model Settings {
  id                String   @id @default(uuid())
  storeId           String   @unique
  store             Store    @relation(fields: [storeId], references: [id])
  invoicePrefix     String   @default("INV")
  purchasePrefix    String   @default("PB")
  currency          String   @default("BDT")
  lowStockThreshold Int      @default(5)
  thermalWidth      String   @default("80mm") // 58mm | 80mm | A4
  updatedAt         DateTime @updatedAt

  @@map("settings")
}
